<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!--
      SCAIS connection string.

      DatabaseManager.EnsureDatabase() runs at start-up and will:
        1. create the SCAIS database if it does not exist, then
        2. apply the embedded schema and seed scripts if the tables are missing.

      This means the application always runs, even on a machine where the
      database has never been created. You do not need to attach a .mdf by hand.
    -->
    <add name="SCAIS"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=SCAIS;Integrated Security=True;MultipleActiveResultSets=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Set to true to run the seed script again on every start-up (development only). -->
    <add key="Scais.ReseedOnStartup" value="false" />
  </appSettings>

</configuration>
